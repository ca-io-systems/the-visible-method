{
  "client": "the-visible-method",
  "brandName": "The Visible Method",
  "brandUrl": "https://the-visible-method.vercel.app/waitlist",
  "hostName": "Jamie Gabrielle",
  "mode": "light",
  "colors": {
    "accent": "#14271C",
    "accentHover": "#1F3A2B",
    "kicker": "#4E1D1B",
    "page": "#FFFFFF",
    "card": "#FFFFFF",
    "text": "#2B1E16",
    "body": "rgba(43,30,22,0.95)",
    "muted": "rgba(43,30,22,0.72)",
    "faint": "rgba(43,30,22,0.62)",
    "border": "rgba(43,30,22,0.3)",
    "line": "rgba(43,30,22,0.16)"
  },
  "radius": {
    "card": "0",
    "button": "999px"
  },
  "button": {
    "primaryBg": "#14271C",
    "primaryText": "#FFFFFF",
    "labelTransform": "uppercase",
    "letterSpacing": "0.18em",
    "fontSize": "11px",
    "fontWeight": "700"
  },
  "font": {
    "display": "Playfair Display",
    "body": "Inter",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap"
  },
  "designSystem": {
    "shell": "formcard",
    "outerBorder": "1px solid rgba(43,30,22,0.3)",
    "innerBorder": "1px solid rgba(201,169,106,0.6)",
    "insetPadding": "7px",
    "cardPadding": "36px 40px",
    "maxWidth": "600px"
  },
  "mergeTags": {
    "contactFirstName": "{{contact.first_name}}",
    "eventZoomLink": "{{custom_values.webby__event_zoom_link}}",
    "eventDateTime": "{{custom_values.webby__event_date__time}}",
    "eventDateOptIn": "{{custom_values.webby__event_date_for_opt_in_message}}",
    "eventDay": "{{custom_values.webby__event_day}}",
    "eventDayTime": "{{custom_values.webby__event_date__time_2}}",
    "whatsappGroupFree": "{{custom_values.webby__whatsapp_group_link_free}}",
    "eventGcalLink": "{{custom_values.webby__event_gcal_link}}",
    "visibleVoiceKitLink": "{{custom_values.webby__whop_payment__47}}",
    "waitlistUrl": "https://the-visible-method.vercel.app/waitlist"
  }
}
